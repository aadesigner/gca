{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "preinstall": "node scripts/preinstall-check.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:dashboard": "pnpm --filter @workspace/admin-dashboard run dev",
    "build:site": "pnpm --filter @workspace/site run build",
    "export:site-assets": "node --import ./scripts/load-env.mjs ./scripts/export-site-assets.mjs",
    "build:railway": "node --import ./scripts/load-env.mjs ./scripts/export-site-assets.mjs && pnpm --filter @workspace/site run build && pnpm --filter @workspace/admin-dashboard run build && pnpm --filter @workspace/api-server run build",
    "start": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "setup:db": "node --import ./scripts/load-env.mjs ./scripts/create-db.mjs && pnpm --filter @workspace/db run migrate && pnpm --filter @workspace/scripts run seed-admin && pnpm --filter @workspace/scripts run seed-providers",
    "check:db": "node --import ./scripts/load-env.mjs ./scripts/check-db.mjs",
    "backfill:encar-locale": "pnpm --filter @workspace/scripts run backfill-encar-locale",
    "backfill:encar-photos": "pnpm --filter @workspace/scripts run backfill-encar-photos",
    "backfill:encar-prices": "pnpm --filter @workspace/scripts run backfill-encar-prices",
    "backfill:source-dates": "pnpm --filter @workspace/scripts run backfill-source-dates",
    "trim:vehicle-photos": "pnpm --filter @workspace/scripts run trim-vehicle-photos",
    "backfill:cars24ae": "pnpm --filter @workspace/scripts run backfill-cars24ae",
    "crawl-health": "node --import ./scripts/load-env.mjs ./scripts/src/im-crawl-health.mjs",
    "crawl-health:watch": "node --import ./scripts/load-env.mjs ./scripts/src/im-crawl-health.mjs --watch",
    "crawl-start-all": "node --import ./scripts/load-env.mjs ./scripts/src/start-all-crawls.mjs",
    "im-full-crawl": "node --import ./scripts/load-env.mjs ./scripts/src/im-enable-full-crawl.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
