{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "pnpm": "11.8.0"
  },
  "steps": {
    "build": {
      "commands": ["pnpm run build:railway"]
    }
  },
  "deploy": {
    "startCommand": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs"
  }
}
