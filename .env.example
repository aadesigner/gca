# Copy to .env and adjust for your machine
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vdip
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
DASHBOARD_PORT=3000
# Comma-separated dashboard URLs. Add Tailscale MagicDNS/IP to log in from a phone:
# ADMIN_ORIGIN=http://localhost:3000,http://100.x.x.x:3000,http://your-pc.tailXXXX.ts.net:3000
ADMIN_ORIGIN=http://localhost:3000
# Dashboard is served at /adminz/ (do not publish this URL)
BASE_PATH=/adminz/
PUBLIC_SITE_URL=https://getcarapi.com
# Hostname(s) that serve API only — no marketing site at /. Comma-separated.
API_PUBLIC_HOST=api.getcarapi.com
NODE_ENV=development
ADMIN_EMAIL=ops@your-domain.example
ADMIN_PASSWORD=

# Optional: proxy for Encar API (avoids IP blocks)
# ENCAR_PROXY=http://user:pass@proxy:8080

# Optional: Autowini bearer token / proxy (search works without a token)
# AUTWINI_TOKEN=
# AUTWINI_PROXY=http://user:pass@proxy:8080

# Optional: KB ChaChaCha proxy — required when this IP is blocked (KB returns a
# meta-refresh to 220.85.44.172/KBchachacha.html). Prefer a KR residential proxy.
# Falls back to ENCAR_PROXY if unset.
# KBCHACHACHA_PROXY=http://user:pass@proxy:8080

# Optional: Auctionwini buyer API token (catalog is login-walled without it)
# AUCTIONWINI_TOKEN=

# Optional: Lotte Auto Global session Cookie header. Guest AJAX often masks USD as ****;
# a logged-in buyer cookie may expose carAmt/dcCarAmt.
# LOTTE_AUTOGLOBAL_COOKIE=

# Optional: import-motor.com — Cloudflare blocks Node TLS even with cf_clearance.
# 1) Start Chrome: chrome --remote-debugging-port=9222 --user-data-dir=%TEMP%\chrome-im-cdp
# 2) Open https://import-motor.com/buyer-locations and pass the check once
# 3) Set:
# IMPORT_MOTOR_CDP_URL=http://127.0.0.1:9222
# IMPORT_MOTOR_CDP_TABS=10
# Optional hard cap on simultaneous navigations (defaults to CDP_TABS):
# IMPORT_MOTOR_CDP_PARALLEL=10
# IMPORT_MOTOR_COOKIE=cf_clearance=...; import_motor_session=...; XSRF-TOKEN=...; locale=...

# Optional: public marketing demo key (otherwise created in Admin → API Tokens)
# PUBLIC_DEMO_API_TOKEN=vdi_…

# reCAPTCHA v3 keys are configured in Admin → Settings (not env).
# Credit price, crypto wallets, and registration toggle live there too.

# Optional: Cloudflare R2 photo mirror (S3-compatible, zero egress)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=getcar-photos
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://imgsv.getcarapi.com
# Auto-upload new VIN photos to R2 after crawl/import (default on when R2_* set):
# R2_MIRROR_ON_CRAWL=1
# Per-VIN mirror workers when photos are saved (1–12; default 6):
# R2_MIRROR_VEHICLE_CONCURRENCY=6
# Background drain batch size / concurrency (runs inside API — no manual loop needed):
# R2_MIRROR_BATCH_LIMIT=200
# R2_MIRROR_BATCH_CONCURRENCY=12
# R2_MIRROR_ACTIVE_MS=8000
# R2_MIRROR_IDLE_MS=45000
# Backfill old photos manually: cd artifacts/api-server && pnpm run build && pnpm run mirror-photos -- --limit 200


